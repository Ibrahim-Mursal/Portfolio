---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { projects, getNeighbours, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { prev, next } = getNeighbours(project.slug);
---

<Base title={`${project.name} — ${project.client}`} description={project.summary}>
  <article>
    <!-- ----------------------------------------------------------- head -->
    <header class="case-head">
      <div class="shell">
        <nav class="crumbs mono" aria-label="Breadcrumb">
          <a href="/work/">Work</a>
          <span aria-hidden="true">/</span>
          <span>{project.name}</span>
        </nav>

        <div class="case-head__meta">
          <p class="mono case-head__client">{project.client}</p>
          <span
            class="badge"
            class:list={[
              { 'badge--live': project.status === 'live' },
              { 'badge--active': project.status === 'active' },
            ]}>{project.statusLabel}</span
          >
        </div>

        <h1 class="case-head__title">{project.name}</h1>
        <p class="lede">{project.summary}</p>

        <Cover cover={project.cover} hue={project.hue} tall />

        <dl class="factbar">
          <div>
            <dt class="mono">Type</dt>
            <dd>{project.kind}</dd>
          </div>
          <div>
            <dt class="mono">Year</dt>
            <dd>{project.year}</dd>
          </div>
          <div class="factbar__wide">
            <dt class="mono">Built with</dt>
            <dd>{project.stack.join(', ')}</dd>
          </div>
        </dl>
      </div>
    </header>

    <!-- --------------------------------------------------------- brief -->
    <section class="section">
      <div class="shell prose-shell">
        <div class="block">
          <h2 class="block__title">The brief</h2>
          <div class="block__body">
            <p>{project.brief}</p>
            <p class="role"><strong>My role.</strong> {project.role}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------- metrics -->
    {
      project.metrics.length > 0 && (
        <section class="metrics-band">
          <div class="shell">
            <ul class="metrics">
              {project.metrics.map((metric) => (
                <li class="metric reveal">
                  <p class="metric__value">{metric.value}</p>
                  <p class="metric__label">{metric.label}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- --------------------------------------------------------- built -->
    <section class="section">
      <div class="shell prose-shell">
        <div class="block">
          <h2 class="block__title">What shipped</h2>
          <ul class="block__body checklist">
            {project.built.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ----------------------------------------------------- hard parts -->
    <section class="section">
      <div class="shell prose-shell">
        <div class="block">
          <h2 class="block__title">What was hard</h2>
          <div class="block__body">
            <ol class="hard">
              {
                project.hardParts.map((part, i) => (
                  <li class="hard__item reveal">
                    <p class="hard__num mono">
                      Problem {String(i + 1).padStart(2, '0')}
                    </p>
                    <div class="hard__row">
                      <p class="hard__key mono">Symptom</p>
                      <p>{part.symptom}</p>
                    </div>
                    <div class="hard__row">
                      <p class="hard__key mono">Cause</p>
                      <p>{part.cause}</p>
                    </div>
                    <div class="hard__row">
                      <p class="hard__key mono">Fix</p>
                      <p>{part.fix}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------------------------------------------------- reflection -->
    <section class="section">
      <div class="shell prose-shell">
        <div class="block">
          <h2 class="block__title">Looking back</h2>
          <div class="block__body">
            <p class="reflection">{project.reflection}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------ neighbours -->
    <nav class="pager" aria-label="More work">
      <div class="shell pager__inner">
        {
          prev && (
            <a class="pager__link" href={`/work/${prev.slug}/`}>
              <span class="mono pager__dir">&larr; Previous</span>
              <span class="pager__name">{prev.name}</span>
              <span class="mono pager__client">{prev.client}</span>
            </a>
          )
        }
        {
          next && (
            <a class="pager__link pager__link--next" href={`/work/${next.slug}/`}>
              <span class="mono pager__dir">Next &rarr;</span>
              <span class="pager__name">{next.name}</span>
              <span class="mono pager__client">{next.client}</span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</Base>

<style>
  /* --------------------------------------------------------------- head */
  .case-head {
    padding-block: clamp(2rem, 5vw, 3rem) 0;
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    color: var(--text-500);
    font-size: 0.75rem;
  }

  .crumbs a {
    text-decoration: none;
  }

  .case-head__meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }

  .case-head__client {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-400);
  }

  .case-head__title {
    font-size: clamp(2.25rem, 7vw, 4rem);
    margin-top: 0.85rem;
    letter-spacing: -0.03em;
  }

  .case-head :global(.cover--tall) {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .factbar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.5rem 2rem;
    margin-top: 2rem;
  }

  .factbar__wide {
    grid-column: span 2;
    min-width: 0;
  }

  .factbar dt {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-500);
  }

  .factbar dd {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--text-200);
  }

  /* -------------------------------------------------------------- blocks */
  /*
   * Two columns on wide screens: the section heading sits in a narrow rail
   * beside the prose, so the reading measure never stretches past ~68ch even
   * on a very wide monitor.
   */
  .block {
    display: grid;
    gap: 1.25rem 3rem;
  }

  @media (min-width: 60rem) {
    .block {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .block__title {
    font-size: 1.0625rem;
    color: var(--azure-400);
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 0.02em;
    padding-top: 0.2rem;
  }

  .block__body {
    max-width: var(--measure);
  }

  .block__body > * + * {
    margin-top: 1.15rem;
  }

  .role {
    color: var(--text-300);
    font-size: 0.9375rem;
  }

  .role strong {
    color: var(--text-200);
  }

  .reflection {
    font-size: 1.0625rem;
    border-left: 2px solid var(--azure-600);
    padding-left: 1.4rem;
  }

  /* ------------------------------------------------------------ metrics */
  .metrics-band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--ink-850);
    padding-block: clamp(2.25rem, 5vw, 3rem);
  }

  .metrics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 2rem;
  }

  .metric__value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1;
    color: var(--text-100);
    letter-spacing: -0.03em;
  }

  .metric__label {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-400);
    max-width: 26ch;
  }

  /* ---------------------------------------------------------- checklist */
  .checklist {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .checklist li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 0.9375rem;
    color: var(--text-300);
  }

  .checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--azure-600);
  }

  /* ---------------------------------------------------------- hard parts */
  .hard {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .hard__item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--ink-850);
    padding: 1.4rem 1.5rem 1.5rem;
  }

  .hard__num {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-500);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .hard__row {
    display: grid;
    gap: 0.3rem;
    padding-top: 1rem;
  }

  @media (min-width: 40rem) {
    .hard__row {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0 1.25rem;
    }
  }

  .hard__key {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--azure-400);
    padding-top: 0.32em;
  }

  .hard__row p:last-child {
    font-size: 0.9375rem;
    color: var(--text-300);
  }

  /* -------------------------------------------------------------- pager */
  .pager {
    border-top: 1px solid var(--border);
  }

  .pager__inner {
    display: grid;
    gap: 1px;
    padding-inline: 0;
  }

  @media (min-width: 44rem) {
    .pager__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 2rem var(--gutter);
    text-decoration: none;
    color: inherit;
    transition: background 0.2s var(--ease);
  }

  .pager__link:hover {
    background: var(--ink-850);
    color: inherit;
  }

  .pager__link--next {
    text-align: right;
    align-items: flex-end;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 44rem) {
    .pager__link--next {
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }

  .pager__dir {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azure-400);
  }

  .pager__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text-100);
  }

  .pager__client {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-500);
  }
</style>
