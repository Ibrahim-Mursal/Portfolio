---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <section class="notfound">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1 class="notfound__title">Nothing here.</h1>
      <p class="lede">That address does not exist.</p>

      <a class="btn btn--primary notfound__btn" href="/">
        <span aria-hidden="true">&larr;</span> Back home
      </a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    padding-block: clamp(3.5rem, 10vw, 7rem);
  }

  .notfound__title {
    margin-top: 0.9rem;
    font-size: clamp(2.25rem, 8vw, 4rem);
  }

  .notfound__btn {
    margin-top: 2rem;
  }
</style>
