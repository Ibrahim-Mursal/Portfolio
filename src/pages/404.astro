---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <section class="notfound">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1 class="notfound__title">That page does not exist</h1>
      <p class="lede">
        Nothing here at this address. The case studies are all one click away.
      </p>

      <ul class="notfound__list">
        {
          projects.map((project) => (
            <li>
              <a href={`/work/${project.slug}/`}>{project.name}</a>
              <span class="mono">{project.client}</span>
            </li>
          ))
        }
      </ul>

      <a class="btn btn--solid" href="/">
        <span aria-hidden="true">&larr;</span> Back home
      </a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    padding-block: clamp(3rem, 9vw, 6rem);
  }

  .notfound__title {
    font-size: clamp(1.85rem, 5.5vw, 3rem);
    margin-top: 0.9rem;
  }

  .notfound__list {
    list-style: none;
    padding: 0;
    margin-block: 2.25rem;
    max-width: 34rem;
  }

  .notfound__list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--border);
  }

  .notfound__list a {
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .notfound__list span {
    color: var(--text-500);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
  }
</style>
