---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Clients from '../components/Clients.astro';
import { site } from '../data/site';
---

<Base title={site.name} description={site.metaDescription}>
  <!-- ------------------------------------------------------------- hero -->
  <section class="hero">
    <div class="shell hero__inner">
      <p class="eyebrow">{site.name}</p>

      <h1 class="hero__title">
        {site.pitch.lead}<br /><span class="hi">{site.pitch.accent}</span>.
      </h1>

      <p class="hero__sub">
        {site.role}. I build the software that takes the slow part of your day and removes
        it.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">Get in touch</a>
        <a class="btn btn--ghost" href="#work">See the work</a>
      </div>
    </div>

    <Clients />
  </section>

  <!-- ------------------------------------------------------------- work -->
  <section class="section" id="work">
    <div class="shell">
      <p class="eyebrow">Work</p>
      <h2 class="section-title">Four things, all in use.</h2>

      <div class="grid">
        {site.projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ about -->
  <section class="section section--edge" id="about">
    <div class="shell about">
      <div>
        <p class="eyebrow">About</p>
        <p class="about__intro">{site.intro}</p>

        <ul class="chips about__skills">
          {site.skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>

      <aside class="about__side">
        <div class="panel">
          <p class="mono panel__label">Studying</p>
          <p class="panel__lead">{site.education.school}</p>
          <p class="panel__sub">{site.education.field}</p>
          <p class="panel__sub">{site.education.standing}, {site.education.period}</p>
        </div>

        <div class="panel">
          <p class="mono panel__label">Languages</p>
          <p class="panel__lead">{site.languages.join(', ')}</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ---------------------------------------------------------- contact -->
  <section class="section contact" id="contact">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h2 class="contact__title">Tell me what is slowing you down.</h2>

      <div class="contact__actions">
        <a class="btn btn--primary" href={`mailto:${site.email}`}>{site.email}</a>
        {
          site.links.map((link) => (
            <a class="btn btn--ghost" href={link.href} rel="noopener">
              {link.label}
            </a>
          ))
        }
      </div>

      <p class="mono contact__meta">{site.phone} &middot; {site.location}</p>
    </div>
  </section>
</Base>

<style>
  /* --------------------------------------------------------------- hero */
  .hero {
    position: relative;
    overflow: hidden;
  }

  /*
   * Two glows behind the hero, cyan over violet. The only place violet appears,
   * and it is purely light: nothing depends on seeing it.
   */
  .hero::before {
    content: '';
    position: absolute;
    inset: -12rem -20% auto -20%;
    height: 42rem;
    background:
      radial-gradient(38% 44% at 28% 42%, var(--cyan-glow) 0%, transparent 72%),
      radial-gradient(34% 40% at 68% 30%, var(--violet-glow) 0%, transparent 72%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    padding-block: clamp(3.5rem, 10vw, 6.5rem) clamp(2.75rem, 7vw, 4.5rem);
  }

  .hero__title {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .hero__sub {
    margin-top: 1.5rem;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: var(--text-300);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.25rem;
  }

  /* The clients strip styles itself, in Clients.astro. */

  /* --------------------------------------------------------------- work */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
    margin-top: clamp(2rem, 5vw, 2.75rem);
  }

  /* -------------------------------------------------------------- about */
  .about {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 58rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 3.5rem;
    }
  }

  /*
   * Set large, in the display face. The text is three short sentences by
   * design, and at body size that reads as a thin paragraph rather than as a
   * statement.
   */
  .about__intro {
    margin-top: 1.1rem;
    max-width: 32ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.8vw, 1.85rem);
    line-height: 1.32;
    letter-spacing: -0.015em;
    color: var(--text-100);
  }

  .about__skills {
    margin-top: 1.5rem;
  }

  .about__side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .panel {
    border: 1px solid var(--border);
    border-left: 2px solid var(--cyan-500);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.1rem 1.25rem 1.25rem;
  }

  .panel__label {
    color: var(--cyan-400);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.6875rem;
  }

  .panel__lead {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--text-100);
  }

  .panel__sub {
    font-size: 0.875rem;
    color: var(--text-400);
  }

  /* ------------------------------------------------------------ contact */
  .contact {
    border-top: 1px solid var(--border);
    background: var(--bg-deep);
  }

  .contact__title {
    margin-top: 0.9rem;
    font-size: clamp(1.85rem, 5.5vw, 3rem);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .contact__meta {
    margin-top: 1.35rem;
    color: var(--text-400);
  }
</style>
