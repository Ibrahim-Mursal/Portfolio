---
/**
 * A project, whole, styled as one entry in a component datasheet. There are
 * no separate case-study pages: four projects with three points each says
 * more than four pages nobody opens.
 */
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

const stroke = 'var(--green)';
const faint = 'var(--rule-strong)';

/** Two-letter maker's mark: authorship on every entry, no invented date. */
const clientInitials = project.client
  .split(' ')
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<article class="entry reveal" style={`--reveal-delay:${Math.min(index, 4) * 70}ms`}>
  <div class="entry__head">
    <div class="entry__mark" aria-hidden="true">
      <svg viewBox="0 0 48 48" role="presentation">
        {
          project.mark === 'label' && (
            <g fill="none" stroke-width="2">
              <rect x="6" y="13" width="36" height="22" rx="2" stroke={stroke} />
              <line x1="12" y1="21" x2="28" y2="21" stroke={stroke} />
              <line x1="12" y1="27" x2="22" y2="27" stroke={faint} />
              <line x1="6" y1="9" x2="42" y2="9" stroke={faint} />
              <line x1="6" y1="39" x2="42" y2="39" stroke={faint} />
            </g>
          )
        }
        {
          project.mark === 'bottle' && (
            <g fill="none" stroke-width="2">
              <path d="M18 10h12v6a10 10 0 0 1 6 9v11a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4V25a10 10 0 0 1 6-9z" stroke={stroke} />
              <line x1="20" y1="6" x2="28" y2="6" stroke={faint} />
              <circle cx="24" cy="29" r="4" stroke={faint} />
            </g>
          )
        }
        {
          project.mark === 'cup' && (
            <g fill="none" stroke-width="2">
              <path d="M11 17h22v13a8 8 0 0 1-8 8h-6a8 8 0 0 1-8-8z" stroke={stroke} />
              <path d="M33 21h4a4 4 0 0 1 0 8h-4" stroke={faint} />
              <line x1="18" y1="8" x2="18" y2="12" stroke={faint} />
              <line x1="26" y1="8" x2="26" y2="12" stroke={faint} />
            </g>
          )
        }
        {
          project.mark === 'till' && (
            <g fill="none" stroke-width="2">
              <rect x="7" y="20" width="34" height="18" rx="2" stroke={stroke} />
              <rect x="14" y="9" width="20" height="11" rx="1" stroke={faint} />
              <line x1="14" y1="28" x2="24" y2="28" stroke={stroke} />
              <line x1="28" y1="28" x2="34" y2="28" stroke={faint} />
            </g>
          )
        }
      </svg>
    </div>

    <div class="entry__titles">
      <p class="mono entry__client">{project.client} &middot; {project.kind}</p>
      <h3 class="entry__name">{project.name}</h3>
    </div>

    <span class="stamp" class:list={[{ 'stamp--live': project.inUse }]}>{project.status}</span>
  </div>

  <p class="entry__summary">{project.summary}</p>

  <ol class="entry__points">
    {project.points.map((point, i) => (
      <li>
        <span class="mono entry__points-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        {point}
      </li>
    ))}
  </ol>

  <p
    class="mono entry__signature"
    title={`Built by ${clientInitials === 'IM' ? 'Ibrahim Mursal' : `Ibrahim Mursal for ${project.client}`}`}
  >
    I.M. &middot; {clientInitials}
  </p>
</article>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem 1.5rem;
    transition: box-shadow 0.22s var(--ease), border-color 0.22s var(--ease);
  }

  .entry:hover {
    border-color: var(--ink-300);
    box-shadow: 0 10px 26px -18px rgba(26, 26, 24, 0.5);
  }

  .entry:hover .stamp--live {
    transform: rotate(-1.5deg) scale(1.05);
  }

  .entry__head {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .entry__mark {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--paper-deep);
    padding: 0.35rem;
  }

  .entry__titles {
    flex: 1;
    min-width: 0;
  }

  .entry__client {
    color: var(--ink-400);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.6875rem;
  }

  .entry__name {
    font-size: 1.5rem;
    margin-top: 0.15rem;
  }

  .entry__summary {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--ink-500);
  }

  .entry__points {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.85rem;
  }

  .entry__points li {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: 0.9375rem;
    color: var(--ink-700);
  }

  .entry__points-num {
    flex: none;
    color: var(--green);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .entry__signature {
    margin-top: auto;
    padding-top: 1.35rem;
    color: var(--ink-400);
    letter-spacing: 0.04em;
    text-align: right;
  }

  @media (max-width: 26rem) {
    /* The stamp and the title fight for room on a narrow phone. */
    .entry__head {
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry:hover .stamp--live {
      transform: none;
    }
  }
</style>
