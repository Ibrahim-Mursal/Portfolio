---
/**
 * A project, whole. There are no separate case-study pages: four projects with
 * three points each says more than four pages nobody opens.
 */
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

const stroke = 'rgba(45, 212, 239, 0.9)';
const faint = 'rgba(255, 255, 255, 0.16)';
---

<article class="card reveal" style={`--reveal-delay:${Math.min(index, 4) * 70}ms`}>
  <div class="card__head">
    <!-- A small drawn mark, one per project. Decorative. -->
    <div class="card__mark" aria-hidden="true">
      <svg viewBox="0 0 48 48" role="presentation">
        {
          project.mark === 'label' && (
            <g fill="none" stroke-width="2">
              <rect x="6" y="13" width="36" height="22" rx="3" stroke={stroke} />
              <line x1="12" y1="21" x2="28" y2="21" stroke={stroke} />
              <line x1="12" y1="27" x2="22" y2="27" stroke={faint} />
              <line x1="6" y1="9" x2="42" y2="9" stroke={faint} />
              <line x1="6" y1="39" x2="42" y2="39" stroke={faint} />
            </g>
          )
        }
        {
          project.mark === 'bottle' && (
            <g fill="none" stroke-width="2">
              <path d="M18 10h12v6a10 10 0 0 1 6 9v11a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4V25a10 10 0 0 1 6-9z" stroke={stroke} />
              <line x1="20" y1="6" x2="28" y2="6" stroke={faint} />
              <circle cx="24" cy="29" r="4" stroke={faint} />
            </g>
          )
        }
        {
          project.mark === 'cup' && (
            <g fill="none" stroke-width="2">
              <path d="M11 17h22v13a8 8 0 0 1-8 8h-6a8 8 0 0 1-8-8z" stroke={stroke} />
              <path d="M33 21h4a4 4 0 0 1 0 8h-4" stroke={faint} />
              <line x1="18" y1="8" x2="18" y2="12" stroke={faint} />
              <line x1="26" y1="8" x2="26" y2="12" stroke={faint} />
            </g>
          )
        }
        {
          project.mark === 'till' && (
            <g fill="none" stroke-width="2">
              <rect x="7" y="20" width="34" height="18" rx="3" stroke={stroke} />
              <rect x="14" y="9" width="20" height="11" rx="2" stroke={faint} />
              <line x1="14" y1="28" x2="24" y2="28" stroke={stroke} />
              <line x1="28" y1="28" x2="34" y2="28" stroke={faint} />
            </g>
          )
        }
      </svg>
    </div>

    <div class="card__titles">
      <p class="mono card__client">{project.client} &middot; {project.kind}</p>
      <h3 class="card__name">{project.name}</h3>
    </div>

    <span class="badge" class:list={[{ 'badge--live': project.inUse }]}>{project.status}</span>
  </div>

  <p class="card__summary">{project.summary}</p>

  <ul class="card__points">
    {project.points.map((point) => <li>{point}</li>)}
  </ul>

  <ul class="chips chips--mono card__stack">
    {project.stack.map((tech) => <li>{tech}</li>)}
  </ul>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem 1.5rem;
    transition: border-color 0.22s var(--ease), background 0.22s var(--ease);
  }

  .card:hover {
    border-color: rgba(45, 212, 239, 0.4);
    background: var(--surface-2);
  }

  .card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .card__mark {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    padding: 0.35rem;
  }

  .card__titles {
    flex: 1;
    min-width: 0;
  }

  .card__client {
    color: var(--text-400);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.6875rem;
  }

  .card__name {
    font-size: 1.375rem;
    margin-top: 0.15rem;
  }

  .card__summary {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--text-300);
  }

  .card__points {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .card__points li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    color: var(--text-200);
  }

  .card__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan-400);
  }

  .card__stack {
    margin-top: auto;
    padding-top: 1.35rem;
  }

  @media (max-width: 26rem) {
    /* The badge and the title fight for room on a narrow phone. */
    .card__head {
      flex-wrap: wrap;
    }
  }
</style>
