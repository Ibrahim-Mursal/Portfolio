---
import Chevrons from './Chevrons.astro';
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <Chevrons flip />

  <div class="site-foot__body">
    <div class="shell site-foot__inner">
      <div>
        <p class="site-foot__name">{profile.name}</p>
        <p class="site-foot__role">{profile.role}, {profile.location}</p>
      </div>

      <ul class="site-foot__links">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        {
          profile.links.map((link) => (
            <li>
              <a href={link.href} rel="noopener">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mono site-foot__meta">&copy; {year}</p>
    </div>
  </div>
</footer>

<style>
  .site-foot__body {
    background: var(--navy-900);
    padding-block: 2.5rem 3rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .site-foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .site-foot__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: #fff;
  }

  .site-foot__role {
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .site-foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
  }

  .site-foot__links a {
    font-size: 0.875rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.82);
  }

  .site-foot__links a:hover {
    color: var(--orange-400);
  }

  .site-foot__meta {
    color: rgba(255, 255, 255, 0.45);
  }
</style>
