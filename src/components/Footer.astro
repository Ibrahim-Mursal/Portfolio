---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="shell site-foot__inner">
    <p class="site-foot__name">{site.name}</p>

    <ul class="site-foot__links">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {
        site.links.map((link) => (
          <li>
            <a href={link.href} rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mono site-foot__meta">&copy; {year}</p>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--border);
    background: var(--bg-deep);
    padding-block: 1.85rem 2.25rem;
  }

  .site-foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
  }

  .site-foot__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--text-100);
  }

  .site-foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
    padding: 0;
  }

  .site-foot__links a {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text-300);
  }

  .site-foot__links a:hover {
    color: var(--cyan-400);
  }

  .site-foot__meta {
    color: var(--text-400);
  }
</style>
