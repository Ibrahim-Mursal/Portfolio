---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="shell site-foot__inner">
    <p class="mono site-foot__meta">
      &copy; {year} {profile.name}
    </p>

    <ul class="site-foot__links">
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      {
        profile.links.map((link) => (
          <li>
            <a href={link.href} rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--border);
    padding-block: 2.5rem 3rem;
    background: var(--ink-850);
  }

  .site-foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
  }

  .site-foot__meta {
    color: var(--text-500);
  }

  .site-foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .site-foot__links a {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text-300);
  }

  .site-foot__links a:hover {
    color: var(--azure-400);
  }
</style>
