---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="shell site-foot__inner">
    <div>
      <p class="site-foot__name">{profile.name}</p>
      <p class="site-foot__role">{profile.role}, {profile.location}</p>
    </div>

    <ul class="site-foot__links">
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
      {
        profile.links.map((link) => (
          <li>
            <a href={link.href} rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mono site-foot__meta">&copy; {year}</p>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--border);
    background: var(--ink-950);
    padding-block: 2.25rem 2.75rem;
  }

  .site-foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .site-foot__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    text-transform: uppercase;
    color: var(--text-100);
  }

  .site-foot__role {
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    color: var(--text-500);
  }

  .site-foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
    padding: 0;
  }

  .site-foot__links a {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text-300);
  }

  .site-foot__links a:hover {
    color: var(--lime-400);
  }

  .site-foot__meta {
    color: var(--text-500);
  }
</style>
