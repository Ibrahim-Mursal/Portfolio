---
import { site } from '../data/site';
---

<header class="site-head">
  <div class="shell site-head__inner">
    <a class="doc-code" href="/">
      <span class="doc-code__doc">PORTFOLIO</span>
    </a>

    <nav aria-label="Primary">
      <a href="/#work">Work</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
      <a class="stamp nav__cta" href="/#contact">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--ink-bg);
    border-bottom: 1px solid var(--on-ink-rule-strong);
    /*
     * Every rule below still reads --ink-500, --green, --rule-strong etc:
     * redefining them here flips the whole subtree to the dark bookend
     * without touching a single downstream color.
     */
    --ink: var(--paper);
    --ink-500: var(--on-ink-500);
    --ink-400: var(--on-ink-400);
    --green: var(--on-ink-green);
    --green-700: var(--on-ink-green-700);
    --rule: var(--on-ink-rule);
    --rule-strong: var(--on-ink-rule-strong);
  }

  .site-head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3.75rem;
  }

  .doc-code {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
  }

  .doc-code__doc {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-500);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
  }

  .nav__cta {
    color: var(--ink);
    transform: none;
  }

  .nav__cta:hover {
    border-color: var(--green);
    color: var(--green-700);
  }

  @media (max-width: 30rem) {
    nav a:not(.nav__cta) {
      display: none;
    }
  }
</style>
