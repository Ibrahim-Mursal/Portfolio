---
import { profile } from '../data/profile';

const path = Astro.url.pathname;
const isWork = path.startsWith('/work');
---

<header class="site-head">
  <div class="shell site-head__inner">
    <a class="wordmark" href="/">
      <span class="wordmark__dot" aria-hidden="true"></span>
      <span class="wordmark__name">{profile.name}</span>
    </a>

    <nav aria-label="Primary">
      <a href="/work/" aria-current={isWork ? 'page' : undefined}>Work</a>
      <a href="/#approach">Approach</a>
      <a class="nav__cta" href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(10, 11, 13, 0.86);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .site-head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 4rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text-100);
  }

  .wordmark__dot {
    width: 9px;
    height: 9px;
    background: var(--lime-400);
    flex: none;
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 1.9rem);
  }

  nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-300);
    text-decoration: none;
    padding-block: 0.3rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--text-100);
  }

  nav a[aria-current='page'] {
    color: var(--text-100);
    border-bottom-color: var(--lime-400);
  }

  .nav__cta {
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
    color: var(--text-100);
  }

  .nav__cta:hover {
    border-color: var(--lime-400);
    color: var(--lime-400);
  }

  @media (max-width: 26rem) {
    .nav__cta {
      display: none;
    }
  }
</style>
