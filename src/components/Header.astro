---
import { site } from '../data/site';
---

<header class="site-head">
  <div class="shell site-head__inner">
    <a class="wordmark" href="/">
      <span class="wordmark__dot" aria-hidden="true"></span>
      <span>{site.name}</span>
    </a>

    <nav aria-label="Primary">
      <a href="/#work">Work</a>
      <a href="/#about">About</a>
      <a class="nav__cta" href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(8, 11, 15, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .site-head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3.75rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text-100);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .wordmark__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan-400);
    flex: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 1.75rem);
  }

  nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-300);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text-100);
  }

  .nav__cta {
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
    color: var(--text-100);
  }

  .nav__cta:hover {
    border-color: var(--cyan-400);
    color: var(--cyan-400);
  }

  @media (max-width: 26rem) {
    .nav__cta {
      display: none;
    }
  }
</style>
