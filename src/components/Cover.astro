---
/**
 * Generated cover art, one motif per project.
 *
 * Deliberately not screenshots and deliberately not device mockups. A
 * screenshot of an admin table says nothing at card size, and a mockup of
 * work that is not public would be fiction. These are abstract marks that
 * refer to the shape of each project: a sheet of labels, a ledger, an accord
 * bloom, a stack of boards, a tower of units.
 */
import type { Project } from '../data/projects';

interface Props {
  cover: Project['cover'];
  hue: number;
  /** Taller framing on the case-study hero. */
  tall?: boolean;
}

const { cover, hue, tall = false } = Astro.props;

const line = `hsl(${hue} 78% 68%)`;
const soft = `hsl(${hue} 70% 62% / 0.30)`;
const faint = `hsl(${hue} 70% 62% / 0.13)`;
const wash = `hsl(${hue} 60% 30% / 0.22)`;

// Deterministic pseudo-random from the hue, so a cover never changes between
// builds but each project gets its own arrangement.
const rand = (i: number) => {
  const x = Math.sin(hue * 12.9898 + i * 78.233) * 43758.5453;
  return x - Math.floor(x);
};
---

<div class="cover" class:list={[{ 'cover--tall': tall }]} aria-hidden="true">
  <svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice" role="presentation">
    <defs>
      <linearGradient id={`g-${cover}-${hue}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={wash} />
        <stop offset="100%" stop-color="transparent" />
      </linearGradient>
    </defs>

    <rect width="400" height="260" fill={`url(#g-${cover}-${hue})`} />

    {
      cover === 'grid' && (
        <g>
          {/* A sheet of label stock, one label being composed. */}
          {Array.from({ length: 12 }).map((_, i) => {
            const col = i % 4;
            const row = Math.floor(i / 4);
            const x = 44 + col * 82;
            const y = 44 + row * 62;
            const active = i === 5;
            return (
              <g>
                <rect
                  x={x}
                  y={y}
                  width={66}
                  height={44}
                  rx={4}
                  fill={active ? faint : 'none'}
                  stroke={active ? line : soft}
                  stroke-width={active ? 1.4 : 1}
                />
                {active && (
                  <g>
                    <rect x={x + 8} y={y + 10} width={30} height={3} rx={1.5} fill={line} />
                    <rect x={x + 8} y={y + 18} width={44} height={2} rx={1} fill={soft} />
                    <rect x={x + 8} y={y + 24} width={22} height={2} rx={1} fill={soft} />
                    <rect x={x + 8} y={y + 32} width={14} height={5} rx={1} fill={line} />
                  </g>
                )}
              </g>
            );
          })}
        </g>
      )
    }

    {
      cover === 'ledger' && (
        <g>
          {/* Rows of value, split between two owners at a moving boundary. */}
          {Array.from({ length: 7 }).map((_, i) => {
            const y = 40 + i * 28;
            const total = 120 + rand(i) * 170;
            const split = total * (0.35 + rand(i + 9) * 0.4);
            return (
              <g>
                <rect x={44} y={y} width={total} height={9} rx={4.5} fill={faint} />
                <rect x={44} y={y} width={split} height={9} rx={4.5} fill={soft} />
                <rect x={44} y={y} width={4} height={9} rx={2} fill={line} />
              </g>
            );
          })}
          <line x1={44} y1={232} x2={356} y2={232} stroke={line} stroke-width="1.2" />
        </g>
      )
    }

    {
      cover === 'bloom' && (
        <g transform="translate(200 130)">
          {/* Accords radiating from one fragrance. */}
          {Array.from({ length: 14 }).map((_, i) => {
            const a = (i / 14) * Math.PI * 2;
            const r = 46 + rand(i) * 62;
            return (
              <g>
                <line
                  x1={Math.cos(a) * 26}
                  y1={Math.sin(a) * 26}
                  x2={Math.cos(a) * r}
                  y2={Math.sin(a) * r}
                  stroke={soft}
                  stroke-width="1"
                />
                <circle
                  cx={Math.cos(a) * r}
                  cy={Math.sin(a) * r}
                  r={2.5 + rand(i + 4) * 3.5}
                  fill={i % 3 === 0 ? line : soft}
                />
              </g>
            );
          })}
          <circle r="22" fill="none" stroke={line} stroke-width="1.4" />
          <circle r="7" fill={line} opacity="0.55" />
        </g>
      )
    }

    {
      cover === 'arc' && (
        <g fill="none" stroke-width="1.2">
          {/* Warm concentric arcs, rising. */}
          {Array.from({ length: 9 }).map((_, i) => (
            <path
              d={`M ${20 - i * 4} 250 A ${150 + i * 20} ${150 + i * 20} 0 0 1 ${
                330 + i * 8
              } 250`}
              stroke={i % 2 === 0 ? soft : faint}
            />
          ))}
          <path
            d="M 60 250 A 140 140 0 0 1 340 250"
            stroke={line}
            stroke-width="1.6"
          />
          <circle cx="200" cy="110" r="5" fill={line} stroke="none" />
        </g>
      )
    }

    {
      cover === 'stack' && (
        <g>
          {/* Boards stacked in oblique projection. */}
          {Array.from({ length: 6 }).map((_, i) => {
            const off = i * 13;
            return (
              <g transform={`translate(${86 - off * 0.55} ${52 + off})`}>
                <path
                  d="M 0 0 L 150 0 L 190 42 L 40 42 Z"
                  fill={i === 0 ? faint : 'none'}
                  stroke={i === 0 ? line : soft}
                  stroke-width={i === 0 ? 1.4 : 1}
                />
              </g>
            );
          })}
          <line x1={44} y1={236} x2={356} y2={236} stroke={faint} stroke-width="1" />
        </g>
      )
    }

    {
      cover === 'tower' && (
        <g>
          {/* Developments made of individually tracked units. */}
          {[
            { x: 70, w: 62, h: 128 },
            { x: 146, w: 74, h: 186 },
            { x: 234, w: 58, h: 104 },
            { x: 306, w: 40, h: 150 },
          ].map((t, ti) => (
            <g>
              <rect
                x={t.x}
                y={236 - t.h}
                width={t.w}
                height={t.h}
                fill="none"
                stroke={ti === 1 ? line : soft}
                stroke-width={ti === 1 ? 1.4 : 1}
              />
              {Array.from({ length: Math.floor(t.h / 22) }).map((_, r) =>
                Array.from({ length: Math.floor(t.w / 20) }).map((_, c) => {
                  const sold = rand(ti * 31 + r * 7 + c) > 0.55;
                  return (
                    <rect
                      x={t.x + 8 + c * 20}
                      y={236 - t.h + 10 + r * 22}
                      width={9}
                      height={11}
                      rx={1}
                      fill={sold ? soft : 'none'}
                      stroke={sold ? 'none' : faint}
                      stroke-width="1"
                    />
                  );
                }),
              )}
            </g>
          ))}
          <line x1={40} y1={236} x2={360} y2={236} stroke={line} stroke-width="1.2" />
        </g>
      )
    }
  </svg>
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 400 / 210;
    background: var(--ink-800);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .cover--tall {
    aspect-ratio: 400 / 168;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .cover svg {
    width: 100%;
    height: 100%;
  }
</style>
