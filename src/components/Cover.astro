---
/**
 * Generated cover art, one motif per project.
 *
 * Deliberately not screenshots and deliberately not device mockups. A
 * screenshot of an admin table says nothing at card size, and a mockup of work
 * that is not public would be fiction. These are abstract marks that refer to
 * the shape of each project: a sheet of labels, a ledger, an accord bloom, a
 * rising arc, a stack of boards.
 *
 * All five use the same lime on near-black. The motif is what distinguishes a
 * project, not a per-project colour: five accent colours across five cards is
 * how a palette stops meaning anything.
 */
import type { Project } from '../data/projects';

interface Props {
  cover: Project['cover'];
  seed: number;
  /** Taller framing on the case-study hero. */
  tall?: boolean;
}

const { cover, seed, tall = false } = Astro.props;

const line = 'rgba(205, 255, 77, 0.85)';
const faint = 'rgba(205, 255, 77, 0.22)';
const fill = 'rgba(205, 255, 77, 0.10)';
const dim = 'rgba(255, 255, 255, 0.14)';

// Deterministic pseudo-random from the seed, so a cover never changes between
// builds while each project still gets its own arrangement.
const rand = (i: number) => {
  const x = Math.sin(seed * 12.9898 + i * 78.233) * 43758.5453;
  return x - Math.floor(x);
};
---

<div class="cover" class:list={[{ 'cover--tall': tall }]} aria-hidden="true">
  <svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice" role="presentation">
    {
      cover === 'grid' && (
        <g>
          {/* A sheet of label stock, one label being composed. */}
          {Array.from({ length: 12 }).map((_, i) => {
            const col = i % 4;
            const row = Math.floor(i / 4);
            const x = 44 + col * 82;
            const y = 44 + row * 62;
            const active = i === 5;
            return (
              <g>
                <rect
                  x={x}
                  y={y}
                  width={66}
                  height={44}
                  rx={3}
                  fill={active ? fill : 'none'}
                  stroke={active ? line : dim}
                  stroke-width={active ? 1.6 : 1}
                />
                {active && (
                  <g>
                    <rect x={x + 8} y={y + 10} width={30} height={3} rx={1.5} fill={line} />
                    <rect x={x + 8} y={y + 18} width={44} height={2} rx={1} fill={faint} />
                    <rect x={x + 8} y={y + 24} width={22} height={2} rx={1} fill={faint} />
                    <rect x={x + 8} y={y + 32} width={14} height={5} rx={1} fill={line} />
                  </g>
                )}
              </g>
            );
          })}
        </g>
      )
    }

    {
      cover === 'ledger' && (
        <g>
          {/* Rows of value, split between two owners at a moving boundary. */}
          {Array.from({ length: 7 }).map((_, i) => {
            const y = 40 + i * 28;
            const total = 120 + rand(i) * 170;
            const split = total * (0.35 + rand(i + 9) * 0.4);
            return (
              <g>
                <rect x={44} y={y} width={total} height={9} rx={4.5} fill={dim} />
                <rect x={44} y={y} width={split} height={9} rx={4.5} fill={faint} />
                <rect x={44} y={y} width={4} height={9} rx={2} fill={line} />
              </g>
            );
          })}
          <line x1={44} y1={232} x2={356} y2={232} stroke={line} stroke-width="1.2" />
        </g>
      )
    }

    {
      cover === 'bloom' && (
        <g transform="translate(200 130)">
          {/* Accords radiating from one fragrance. */}
          {Array.from({ length: 14 }).map((_, i) => {
            const a = (i / 14) * Math.PI * 2;
            const r = 46 + rand(i) * 62;
            const hot = i % 3 === 0;
            return (
              <g>
                <line
                  x1={Math.cos(a) * 26}
                  y1={Math.sin(a) * 26}
                  x2={Math.cos(a) * r}
                  y2={Math.sin(a) * r}
                  stroke={dim}
                  stroke-width="1"
                />
                <circle
                  cx={Math.cos(a) * r}
                  cy={Math.sin(a) * r}
                  r={2.5 + rand(i + 4) * 3.5}
                  fill={hot ? line : faint}
                />
              </g>
            );
          })}
          <circle r="22" fill="none" stroke={line} stroke-width="1.4" />
          <circle r="7" fill={line} />
        </g>
      )
    }

    {
      cover === 'arc' && (
        <g fill="none" stroke-width="1.2">
          {/* Concentric arcs, rising. */}
          {Array.from({ length: 9 }).map((_, i) => (
            <path
              d={`M ${20 - i * 4} 250 A ${150 + i * 20} ${150 + i * 20} 0 0 1 ${
                330 + i * 8
              } 250`}
              stroke={i % 2 === 0 ? dim : fill}
            />
          ))}
          <path d="M 60 250 A 140 140 0 0 1 340 250" stroke={line} stroke-width="1.6" />
          <circle cx="200" cy="110" r="6" fill={line} stroke="none" />
        </g>
      )
    }

    {
      cover === 'stack' && (
        <g>
          {/* Boards stacked in oblique projection. */}
          {Array.from({ length: 6 }).map((_, i) => {
            const off = i * 13;
            const top = i === 0;
            return (
              <g transform={`translate(${86 - off * 0.55} ${52 + off})`}>
                <path
                  d="M 0 0 L 150 0 L 190 42 L 40 42 Z"
                  fill={top ? fill : 'none'}
                  stroke={top ? line : dim}
                  stroke-width={top ? 1.6 : 1}
                />
              </g>
            );
          })}
          <line x1={44} y1={236} x2={356} y2={236} stroke={faint} stroke-width="1" />
        </g>
      )
    }
  </svg>
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 400 / 200;
    background: var(--ink-800);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .cover--tall {
    aspect-ratio: 400 / 160;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .cover svg {
    width: 100%;
    height: 100%;
  }
</style>
